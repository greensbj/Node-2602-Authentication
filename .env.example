NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/auth_demo

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

CLIENT_URL=http://localhost:5001
BCRYPT_SALT_ROUNDS=10

# Security timings in milliseconds.
# LOCK_TIME_MS is short here so the lockout can be demonstrated without
# waiting. Use 900000 (15 minutes) in production.
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MS=5000
RESET_TOKEN_TTL_MS=900000
VERIFY_TOKEN_TTL_MS=86400000
